---
/**
 * Hero der Leistungsseiten (Landingpage für Google Ads): Foto mit Verlauf wie
 * auf der Startseite, Brotkrumen, H1 mit Keyword + Region, CTAs und rechts ein
 * Kurzformular, damit Anfragen ohne Scrollen möglich sind.
 */
import Bildflaeche from '../ui/Bildflaeche.astro';
import Icon from '../ui/Icon.astro';
import KachelButton from '../ui/KachelButton.astro';
import TelefonButton from '../ui/TelefonButton.astro';
import Breadcrumb from '../seo/Breadcrumb.astro';
import Formular from './Formular.astro';
import { weichTrennen } from '../../lib/trennen';
import type { Krume } from '../seo/jsonld';
import type { Leistungsseite } from '../../data/leistungen/typ';
import { firma } from '../../data/firma';

interface Props {
  hero: Leistungsseite['hero'];
  pfad: Krume[];
  aktuell: string;
  /** Option „Leistung", die beide Formulare mitschicken bzw. vorauswählen */
  formularLeistung: string;
}
const { hero, pfad, aktuell, formularLeistung } = Astro.props;
const zeilenHuelle = '-mt-[0.14em] block overflow-hidden pt-[0.14em] pb-[0.06em]';
---
<section class="relative flex min-h-leistung-hero-min flex-col justify-end overflow-hidden bg-ink text-white">
  <div class="absolute inset-0">
    <Bildflaeche bild={hero.bild} alt={hero.alt} motiv={hero.motiv} sizes="100vw" widths={[828, 1000]} prioritaet />
  </div>
  <div class="pointer-events-none absolute inset-0 bg-linear-to-b from-ink/55 via-ink/45 via-35% to-ink/90"></div>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-200 bg-linear-to-b from-ink/50 to-transparent"></div>

  <div class="relative mx-auto w-full max-w-content px-page-x pt-150 pb-f24-40">
    <div class="grid items-end gap-x-f40-96 gap-y-48 nav:spalten-leistungs-hero">
      <div>
        <Breadcrumb pfad={pfad} aktuell={aktuell} class="mb-f28-44" />
        <div class="mb-f20-32 flex items-center gap-14 font-mono text-13 tracking-p010 uppercase text-stone">
          <span class="h-1 w-28 shrink-0 bg-gold"></span>{hero.eyebrow}
        </div>
        <h1 class="m-0 max-w-1000 text-hero leading-096 font-medium tracking-n050">
          {hero.zeilen.map((z, i) => (
            <span class={zeilenHuelle}>
              <span data-reveal data-delay={String(i * 80)} class:list={['block', i === hero.zeilen.length - 1 && 'text-gold']}>{weichTrennen(z)}</span>
            </span>
          ))}
        </h1>
        <p class="mt-f20-32 mb-0 max-w-560 text-hero-lead leading-150 text-pretty text-stone">{hero.text}</p>
        <div class="mt-f28-44 flex flex-wrap items-center gap-f8-12">
          <KachelButton variante="hero" href="#anfrage" vorauswahl={formularLeistung}>{hero.cta}</KachelButton>
          <TelefonButton />
        </div>
      </div>

      <div class="rounded-28 bg-paper p-f24-36 text-ink" id="schnellanfrage">
        <h2 class="m-0 text-24 leading-110 font-medium tracking-n030">Angebot für Ihr Objekt</h2>
        <p class="mt-8 mb-20 text-15 text-muted">Kurz die Eckdaten, wir melden uns mit einem Termin zur Besichtigung.</p>
        <Formular
          felder={[
            { art: 'versteckt', name: 'leistung', label: 'Leistung', wert: formularLeistung },
            { art: 'text', name: 'ort', label: 'Ort / PLZ', placeholder: 'z. B. 68161 Mannheim', pflicht: true },
            { art: 'text', name: 'name', label: 'Name', autocomplete: 'name', pflicht: true },
            { art: 'tel', name: 'telefon', label: 'Telefon', autocomplete: 'tel', pflicht: true },
            { art: 'email', name: 'email', label: 'E-Mail', autocomplete: 'email', pflicht: true },
          ]}
          betreff={`Schnellanfrage ${aktuell} über service-gdm.de`}
          absendenText="Angebot anfordern"
          datenschutzHref="/datenschutz"
        >
          <div slot="danke" class="flex flex-col gap-12 py-24">
            <Icon name="check" class="flex size-56 items-center justify-center rounded-pill bg-ink text-24 text-white" />
            <h3 class="mt-8 mb-0 text-24 font-medium tracking-n030">Vielen Dank!</h3>
            <p class="m-0 text-muted">Wir melden uns in Kürze. Bei Rückfragen: {firma.telefon}.</p>
          </div>
        </Formular>
      </div>
    </div>

    <ul class="raster-180 mt-f56-96 mb-0 grid list-none gap-x-24 gap-y-12 border-t border-white/18 p-0 pt-f20-32">
      {hero.fakten.map((f) => (
        <li class="flex items-center gap-10 text-15 font-medium"><Icon name="check" class="text-20 text-gold" />{f}</li>
      ))}
      <li class="flex items-center gap-10 text-15 font-medium">
        <Icon name="star" gefuellt class="text-20 text-gold" />{firma.google.sterne} bei Google ({firma.google.anzahl} Bewertungen)
      </li>
    </ul>
  </div>
</section>
