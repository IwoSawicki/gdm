---
/**
 * Formular-Mechanik: Felder per Prop, Honeypot, Versand über FormSubmit.co,
 * Danke-Zustand (Slot „danke") und Fehlermeldung.
 *
 * Links mit `data-vorauswahl="<Wert>"` irgendwo auf der Seite belegen beim
 * Klick das Auswahlfeld `vorauswahlFeld` vor (Entwurf: go('Baureinigung')).
 */
import { dienste } from '../../data/dienste';
import { firma, telHref } from '../../data/firma';
import KachelButton from '../ui/KachelButton.astro';

interface FeldBasis {
  name: string;
  label: string;
  pflicht?: boolean;
  /** über die volle Breite (grid-column 1/-1) */
  breit?: boolean;
}
export type Feld =
  | (FeldBasis & {
      art: 'text' | 'tel' | 'email' | 'date' | 'zahl';
      autocomplete?: string;
      placeholder?: string;
    })
  | (FeldBasis & { art: 'versteckt'; wert: string })
  | (FeldBasis & { art: 'auswahl'; optionen: string[]; /** vorausgewählte Option */ vorbelegt?: string });

interface Props {
  felder: Feld[];
  /** Betreff der E-Mail */
  betreff: string;
  absendenText: string;
  /** name des Auswahlfelds, das per data-vorauswahl vorbelegt wird */
  vorauswahlFeld?: string;
  datenschutzHref: string;
}
const { felder, betreff, absendenText, vorauswahlFeld, datenschutzHref } = Astro.props;

type Versteckt = Extract<Feld, { art: 'versteckt' }>;
const versteckte = felder.filter((f): f is Versteckt => f.art === 'versteckt');
const sichtbare = felder.filter((f): f is Exclude<Feld, Versteckt> => f.art !== 'versteckt');

const labelKlasse = 'flex flex-col gap-8 text-13 font-medium text-muted';
const feldKlasse = 'h-56 rounded-14 border border-line-strong bg-sand-input px-16 text-16 text-ink';
---
<div data-formular>
  <form
    class="raster-220 grid gap-x-16 gap-y-20"
    action={`https://formsubmit.co/${dienste.formsubmit.ziel}`}
    method="post"
    data-formular-form
    data-ziel={dienste.formsubmit.ziel}
    data-vorauswahl-feld={vorauswahlFeld}
  >
    <!-- FormSubmit.co: Betreff, Tabellen-Mail, ohne Captcha-Zwischenseite -->
    <input type="hidden" name="_subject" value={betreff} />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_captcha" value="false" />
    <!-- Rücksprung nach klassischem Versand (Fallback), setzt das Skript -->
    <input type="hidden" name="_next" value="" data-formular-zurueck />
    <!-- Honeypot: bleibt bei Menschen leer -->
    <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

    {versteckte.map((f) => <input type="hidden" name={f.name} value={f.wert} />)}
    {sichtbare.map((f) => (
      <label class:list={[labelKlasse, f.breit && 'col-span-full']}>
        {f.label}
        {f.art === 'auswahl' ? (
          <select name={f.name} required={f.pflicht} class={feldKlasse}>
            <option value="">Bitte wählen</option>
            {f.optionen.map((o) => <option value={o} selected={o === f.vorbelegt}>{o}</option>)}
          </select>
        ) : (
          <input
            name={f.name}
            type={f.art === 'zahl' ? 'text' : f.art}
            inputmode={f.art === 'zahl' ? 'numeric' : undefined}
            autocomplete={f.autocomplete}
            placeholder={f.placeholder}
            required={f.pflicht}
            class={feldKlasse}
          />
        )}
      </label>
    ))}

    <label class="col-span-full flex items-start gap-10 text-13 leading-145 text-label">
      <input required name="datenschutz" value="zugestimmt" type="checkbox" class="mt-2 size-18 shrink-0 accent-ink" />
      <span>Ich stimme zu, dass meine Angaben zur Bearbeitung der Anfrage verwendet werden. Hinweise in der <a href={datenschutzHref} class="text-ink underline underline-offset-3">Datenschutzerklärung</a>.</span>
    </label>

    <p class="col-span-full m-0 text-15 text-ink" role="alert" hidden data-formular-fehler>
      Das hat leider nicht geklappt. Bitte versuchen Sie es noch einmal oder rufen Sie uns an: <a href={telHref} class="font-medium underline underline-offset-3">{firma.telefon}</a>
    </p>

    <KachelButton variante="gold" type="submit" class="col-span-full disabled:opacity-60" data-formular-absenden>{absendenText}</KachelButton>
  </form>

  <div hidden data-formular-danke>
    <slot name="danke" />
  </div>
</div>

<script>
  const gesendet = new URLSearchParams(location.search).get('gesendet');
  document.querySelectorAll<HTMLElement>('[data-formular]').forEach((huelle, nr) => {
    const form = huelle.querySelector<HTMLFormElement>('[data-formular-form]');
    const danke = huelle.querySelector<HTMLElement>('[data-formular-danke]');
    const fehler = huelle.querySelector<HTMLElement>('[data-formular-fehler]');
    const absenden = huelle.querySelector<HTMLButtonElement>('[data-formular-absenden]');
    if (!form || !danke || !fehler || !absenden) return;

    const melden = (leistung: string) => {
      form.hidden = true;
      danke.hidden = false;
      // Erfolgsmeldung für die Messung (BaseLayout → Umami, GA generate_lead)
      document.dispatchEvent(new CustomEvent('gdm:anfrage', { detail: { leistung, formular: form.querySelector<HTMLInputElement>('[name=_subject]')?.value ?? '' } }));
    };

    // Rücksprung nach klassischem Versand: ?gesendet=<nr> zeigt das Danke dieses Formulars
    const zurueck = form.querySelector<HTMLInputElement>('[data-formular-zurueck]');
    if (zurueck) zurueck.value = `${location.origin}${location.pathname}?gesendet=${nr}`;
    if (gesendet === String(nr)) {
      melden('');
      huelle.scrollIntoView({ block: 'center' });
    }

    // Vorauswahl über CTAs der Seite
    const feldName = form.dataset.vorauswahlFeld;
    if (feldName) {
      document.addEventListener('click', (e) => {
        const ausloeser = (e.target as Element | null)?.closest<HTMLElement>('[data-vorauswahl]');
        const wert = ausloeser?.dataset.vorauswahl;
        const feld = form.elements.namedItem(feldName);
        if (wert && feld instanceof HTMLSelectElement) feld.value = wert;
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      fehler.hidden = true;
      absenden.disabled = true;
      const daten = Object.fromEntries(new FormData(form).entries());
      try {
        const antwort = await fetch(`https://formsubmit.co/ajax/${encodeURIComponent(form.dataset.ziel ?? '')}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(daten),
        });
        const ergebnis = await antwort.json().catch(() => null);
        // FormSubmit liefert success als String „true“ oder als Boolean
        if (ergebnis?.success === true || ergebnis?.success === 'true') {
          melden(String(daten.leistung ?? ''));
          absenden.disabled = false;
          return;
        }
        // Noch nicht aktivierte Adresse u. Ä.: klassisch absenden. FormSubmit
        // zeigt dann seine Seite (bzw. verschickt die Aktivierungs-Mail) und
        // leitet über _next hierher zurück.
        form.submit();
      } catch {
        // Netzwerkfehler: Fehlermeldung mit Telefonnummer statt stiller Abbruch
        fehler.hidden = false;
        absenden.disabled = false;
      }
    });

    // „Weitere Anfrage" setzt das Formular zurück
    danke.querySelectorAll('[data-formular-neu]').forEach((knopf) => {
      knopf.addEventListener('click', () => {
        form.reset();
        danke.hidden = true;
        form.hidden = false;
      });
    });
  });
</script>
