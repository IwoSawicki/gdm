---
/**
 * Kundenstimmen-Karussell: Google-Gesamtwertung vorn, danach echte
 * Bewertungen (data/bewertungen.ts) als <figure>/<blockquote>/<figcaption>.
 * Startseite (07, sand) und Leistungs-/Übersichtsseiten (hell oder sand).
 */
import GoogleBewertung from './GoogleBewertung.astro';
import Karussell from './Karussell.astro';
import { initialen, type Bewertung } from '../../data/bewertungen';

type Variante = 'sand' | 'hell';
interface Props {
  eyebrow: string;
  titel: string;
  eintraege: Bewertung[];
  /** sand = sandfarbene Sektion/weiße Karten, hell = weiße Sektion/sandfarbene Karten */
  variante?: Variante;
  spurId?: string;
}
const { eyebrow, titel, eintraege, variante = 'sand', spurId = 'stimmen-spur' } = Astro.props;
const karte: Record<Variante, string> = { sand: 'bg-paper', hell: 'bg-sand' };
const avatar: Record<Variante, string> = { sand: 'bg-sand-avatar', hell: 'bg-paper' };
---
<Karussell spurId={spurId} eyebrow={eyebrow} titel={titel} ausgleichen abstand="stimmen" label="Kundenstimmen" variante={variante}>
  <GoogleBewertung variante="karussell" data-reveal />
  {eintraege.map((k, i) => (
    <figure data-reveal data-delay={String(Math.min(i + 1, 4) * 80)} class:list={['m-0 flex min-h-400 shrink-0 grow-0 basis-karte-stimme snap-start flex-col justify-between gap-32 rounded-24 p-28', karte[variante]]}>
      <div class="flex flex-col gap-20">
        <span aria-hidden="true" class="h-24 text-56 leading-050 font-medium text-gold">“</span>
        <blockquote class="m-0">
          <p class="m-0 text-17 leading-150 text-pretty text-quote">{k.text}</p>
        </blockquote>
      </div>
      <figcaption class="flex items-center gap-12 border-t border-sand-quote pt-20">
        <span aria-hidden="true" class:list={['flex size-44 shrink-0 items-center justify-center rounded-pill text-14 font-semibold text-muted', avatar[variante]]}>{initialen(k)}</span>
        <div class="min-w-0">
          <div class="text-15 font-medium">{k.name}</div>
          <div class="text-13 text-label">{k.quelle}-Bewertung · {k.jahr}</div>
        </div>
      </figcaption>
    </figure>
  ))}
</Karussell>
