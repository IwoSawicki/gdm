---
/** 07 — Kundenstimmen (Karussell). Zitate sind noch Platzhalter des Entwurfs. */
import GoogleBewertung from '../../blocks/GoogleBewertung.astro';
import Karussell from '../../blocks/Karussell.astro';
import { kundenstimmen } from '../../../data/startseite';
---
<Karussell spurId="stimmen-spur" eyebrow={kundenstimmen.eyebrow} titel={kundenstimmen.titel} ausgleichen abstand="stimmen" label="Kundenstimmen">
  <GoogleBewertung variante="karussell" data-reveal />
  {kundenstimmen.eintraege.map((k, i) => (
    <figure data-reveal data-delay={String((i + 1) * 80)} class="m-0 flex min-h-400 shrink-0 grow-0 basis-karte-stimme snap-start flex-col justify-between gap-32 rounded-24 bg-paper p-28">
      <div class="flex flex-col gap-20">
        <span aria-hidden="true" class="h-24 text-56 leading-050 font-medium text-gold">“</span>
        <blockquote class="m-0">
          <p class="m-0 text-17 leading-150 text-pretty text-quote">{k.zitat}</p>
        </blockquote>
      </div>
      <figcaption class="flex items-center gap-12 border-t border-sand-quote pt-20">
        <span aria-hidden="true" class="flex size-44 shrink-0 items-center justify-center rounded-pill bg-sand-avatar text-14 font-semibold text-muted">{k.initialen}</span>
        <div class="min-w-0">
          <div class="text-15 font-medium">{k.name}</div>
          <div class="text-13 text-label">{k.rolle}</div>
        </div>
      </figcaption>
    </figure>
  ))}
</Karussell>
