---
/**
 * Bildfläche, die ihren (positionierten) Container füllt.
 * Ohne `bild` zeigt sie das Motiv aus dem Entwurf als sichtbaren
 * Platzhalter — bis das echte Foto geliefert ist.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  bild?: ImageMetadata;
  /** beschreibender Alt-Text; leer bei rein dekorativen Bildern */
  alt?: string;
  /** Motivbeschreibung aus dem Entwurf (Platzhaltertext) */
  motiv: string;
  /** sizes-Attribut passend zur Darstellungsbreite */
  sizes: string;
  /** erzeugte Breiten, größte = Darstellungsbreite × 2 */
  widths: number[];
  /** Ausschnitt, z. B. 'object-[50%_15%]' */
  ausschnitt?: string;
  /** Hero-Bild: sofort laden */
  prioritaet?: boolean;
  /** zunächst unsichtbar (z. B. spätere Hero-Slides): niedrige Ladepriorität,
   *  damit das sichtbare Bild und die Schriften zuerst kommen */
  nachrangig?: boolean;
}
const { bild, alt = '', motiv, sizes, widths, ausschnitt = 'object-center', prioritaet = false, nachrangig = false } = Astro.props;
---
{bild ? (
  <Picture
    src={bild}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    quality={70}
    loading={prioritaet ? 'eager' : 'lazy'}
    fetchpriority={prioritaet ? 'high' : nachrangig ? 'low' : 'auto'}
    class:list={['absolute inset-0 size-full object-cover', ausschnitt]}
  />
) : (
  <div class="absolute inset-0 flex items-center justify-center bg-dim-on-dark/10 p-12 text-center" data-platzhalter>
    <span class="max-w-[90%] text-13 font-medium leading-[1.3] opacity-75">{motiv}</span>
  </div>
)}
