---
import BaseLayout from '../layouts/BaseLayout.astro';
import Laufband from '../components/blocks/Laufband.astro';
import Hero from '../components/sections/startseite/Hero.astro';
import Manifest from '../components/sections/startseite/Manifest.astro';
import Bereiche from '../components/sections/startseite/Bereiche.astro';
import Leistungen from '../components/sections/startseite/Leistungen.astro';
import Warum from '../components/sections/startseite/Warum.astro';
import Schritte from '../components/blocks/Schritte.astro';
import Referenzen from '../components/sections/startseite/Referenzen.astro';
import Einsatzgebiet from '../components/blocks/Einsatzgebiet.astro';
import Kundenstimmen from '../components/sections/startseite/Kundenstimmen.astro';
import Faq from '../components/blocks/Faq.astro';
import Anfrage from '../components/blocks/Anfrage.astro';
import { faqJsonLd } from '../components/seo/jsonld';
import { ablauf, faq, gebietEyebrow, laufband, meta } from '../data/startseite';

const faqLd = faqJsonLd(faq.eintraege);
---
<BaseLayout title={meta.title} description={meta.description} canonical="/" kopf="ueber-bild" jsonLd={[faqLd]}>
  <Hero />
  <Laufband eintraege={laufband} />
  <Manifest />
  <Bereiche />
  <Leistungen />
  <Warum />
  <Schritte id="ablauf" eyebrow={ablauf.eyebrow} titel={ablauf.titel} cta={ablauf.cta} schritte={ablauf.schritte} />
  <Referenzen />
  <Einsatzgebiet eyebrow={gebietEyebrow} />
  <Kundenstimmen />
  <Faq eyebrow={faq.eyebrow} titel={faq.titel} hinweis={faq.hinweis} eintraege={faq.eintraege} />
  <Anfrage />
</BaseLayout>
