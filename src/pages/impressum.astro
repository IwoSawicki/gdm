---
import RechtstextLayout from '../layouts/RechtstextLayout.astro';
import roh from '../data/rechtstexte/impressum.html?raw';
import { adresseEinzeilig, eckdatenEinsetzen, firma } from '../data/firma';
// Eckdaten nur aus firma.ts — im HTML stehen Platzhalter
const html = eckdatenEinsetzen(roh);
---
<RechtstextLayout title="Impressum | GDM Gebäude Dienstleistung Management" description={`Impressum von ${firma.name}, ${adresseEinzeilig}.`} h1="Impressum" html={html} />
