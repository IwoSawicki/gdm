---
/**
 * Leistungsseiten unter /<slug> (flache Adressen wie auf der alten Website,
 * damit bestehende Rankings erhalten bleiben). Aufbau für alle Leistungen
 * gleich — Inhalte aus src/data/leistungen/<slug>.ts.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Anfrage from '../components/blocks/Anfrage.astro';
import Einsatzgebiet from '../components/blocks/Einsatzgebiet.astro';
import Faq from '../components/blocks/Faq.astro';
import KartenRaster from '../components/blocks/KartenRaster.astro';
import LeistungsHero from '../components/blocks/LeistungsHero.astro';
import Leistungsumfang from '../components/blocks/Leistungsumfang.astro';
import Schritte from '../components/blocks/Schritte.astro';
import Vergleich from '../components/blocks/Vergleich.astro';
import Versprechen from '../components/blocks/Versprechen.astro';
import VerwandteLeistungen from '../components/blocks/VerwandteLeistungen.astro';
import { breadcrumbJsonLd, dienstJsonLd, faqJsonLd, type Krume } from '../components/seo/jsonld';
import { einsatzgebiet } from '../data/einsatzgebiet';
import { leistungPerSlug } from '../data/leistungen/katalog';
import { gebaeudereinigung } from '../data/bereiche/gebaeudereinigung';
import { leistungsseiten } from '../data/leistungen';
import type { Leistungsseite } from '../data/leistungen/typ';

export const getStaticPaths = (() =>
  leistungsseiten.map((seite) => ({ params: { leistung: seite.slug }, props: { seite } }))) satisfies GetStaticPaths;

interface Props {
  seite: Leistungsseite;
}
const { seite } = Astro.props;
const name = leistungPerSlug(seite.slug)?.name ?? seite.hero.zeilen[0];
const site = Astro.site ?? new URL('https://service-gdm.de');
// Alle Leistungsseiten gehören bisher zum Bereich Gebäudereinigung & Service
const pfad: Krume[] = [
  { text: 'Startseite', href: '/' },
  { text: gebaeudereinigung.name, href: `/${gebaeudereinigung.slug}` },
];

const jsonLd = [
  dienstJsonLd(name, seite.description, new URL(`/${seite.slug}`, site).href, einsatzgebiet.orte.map((o) => o.ort), site),
  breadcrumbJsonLd([...pfad, { text: name, href: `/${seite.slug}` }], site),
  faqJsonLd(seite.faq.eintraege),
];
---
<BaseLayout title={seite.title} description={seite.description} kopf="ueber-bild" jsonLd={jsonLd}>
  <LeistungsHero hero={seite.hero} pfad={pfad} aktuell={name} formularLeistung={seite.formularLeistung} />
  <Vergleich vergleich={seite.vergleich} />
  <Leistungsumfang umfang={seite.umfang} />
  <KartenRaster eyebrow={seite.turnus.eyebrow} titel={seite.turnus.titel} lead={seite.turnus.lead} karten={seite.turnus.karten} variante="dunkel" nummeriert />
  <KartenRaster eyebrow={seite.zielgruppen.eyebrow} titel={seite.zielgruppen.titel} lead={seite.zielgruppen.lead} karten={seite.zielgruppen.karten} />
  <Versprechen versprechen={seite.versprechen} />
  <Schritte id="ablauf" eyebrow={seite.ablauf.eyebrow} titel={seite.ablauf.titel} cta={seite.ablauf.cta} schritte={seite.ablauf.schritte} />
  <KartenRaster eyebrow={seite.preis.eyebrow} titel={seite.preis.titel} lead={seite.preis.lead} karten={seite.preis.karten} variante="sand" />
  <Einsatzgebiet eyebrow={seite.einsatzgebiet.eyebrow} text={seite.einsatzgebiet.text} />
  <Faq eyebrow={seite.faq.eyebrow} titel={seite.faq.titel} hinweis={seite.faq.hinweis} eintraege={seite.faq.eintraege} />
  <VerwandteLeistungen slugs={seite.verwandt} />
  <Anfrage vorauswahl={seite.formularLeistung} />
</BaseLayout>
